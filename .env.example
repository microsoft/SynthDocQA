# Copy to .env in your working directory. Never commit real credentials.
AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com
AZURE_OPENAI_DEPLOYMENT=your-deployment
AZURE_OPENAI_API_VERSION=2024-02-01
AZURE_OPENAI_API_KEY=
# Optional tier overrides; when unset, existing model-tier fallback applies.
AZURE_OPENAI_DEPLOYMENT_EASY=
AZURE_OPENAI_DEPLOYMENT_MEDIUM=
AZURE_OPENAI_DEPLOYMENT_HARD=
# Required only when using the existing interactive Entra authentication route.
AZURE_TENANT_ID=
